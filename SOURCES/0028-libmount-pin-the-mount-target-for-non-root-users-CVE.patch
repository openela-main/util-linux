 libmount/src/context_mount.c     |  75 +++++++++++++++++++++--
 libmount/src/fs.c                |  26 ++++++++
 libmount/src/hook_idmap.c        |  52 +++++++++++++++-
 libmount/src/hook_mount.c        |  39 ++++++------
 libmount/src/hook_mount_legacy.c |  74 +++++++++++++++++++++-
