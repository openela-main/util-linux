From 482998fd86c3d7bdd91d45dfea48e7194e6a4c7e Mon Sep 17 00:00:00 2001
From: Karel Zak <kzak@redhat.com>
Date: Fri, 11 Sep 2026 19:06:16 +0200
Subject: libmount: skip post-mount hooks after a failed mount helper
 [CVE-2026-76642]

When an external mount.<type> helper exits nonzero, exec_helper() stores
the failure in helper_status but returns zero -- zero means the
fork/exec/wait infrastructure worked, not that the mount succeeded.  The
zero propagated as the mount result and MNT_STAGE_MOUNT_POST and
MNT_STAGE_POST hooks ran as if a filesystem had been attached.  The
hooks then operate on the pre-existing target:

 * X-mount.idmap= clones and idmaps the target, creating an overmount
   which inherits suid/exec from the underlying filesystem and ignores
   nosuid, nodev and noexec from fstab,

 * X-mount.owner=, X-mount.group= and X-mount.mode= change the ownership
   and the permissions of the physical target directory, and the change
   survives -- there is no mount to unmount.

Gate both stages on the new is_mount_stage_failed(), which distinguishes
the helper exit status from the process execution status.  This is a
central fix, the individual hooks need no guard of their own.
hook_loopdev.c is the one exception: its MOUNT_POST hook is now skipped,
so hookset_deinit() has to release the loop device instead of only
freeing the hook data.

Reproducer, with a /sbin/mount.faketype helper which exits 1:

	# stat -c %a /mnt/x
	755
	# mount -t faketype -o X-mount.mode=0700 none /mnt/x
	# stat -c %a /mnt/x
	700		<- before this commit, nothing is mounted
	755		<- after

Backport notes:

 * Taken from the upstream stable/v2.42 branch, which records the master
   commit in its own message.

 * The comment in is_mount_stage_failed() mentions the deferred
   move_mount() of bind/move operations; that is the reason why the
   "nothing happened" case must not be treated as a failure, and it
   applies to this branch as well.

 * is_termination_status() and the EROFS loop retry, which the upstream
   hunks are anchored on, do not exist here; only the two guards and the
   new helper are taken.

Audit of the hooks registered at these stages, unchanged from upstream:

 MNT_STAGE_MOUNT_POST:
  - hook_mount.c (attach, propagation, vfsflags): already skipped when
    a helper was executed
  - hook_idmap.c: would clone+idmap the pre-existing target -- now
    blocked
  - hook_subdir.c: deinit calls tmptgt_cleanup() -- safe
  - hook_mount_legacy.c (propagation, bindremount): no resources to leak
  - hook_loopdev.c: deinit newly calls delete_loopdev() when the cleanup
    hook is skipped (it only free()d the data, leaking the fd and the
    device)
  - hook_veritydev.c: deinit calls delete_veritydev() -- safe

 MNT_STAGE_POST:
  - hook_owner.c: would chown/chmod the target -- now blocked; its
    deinit only frees the uid/gid/mode struct, nothing to leak

CVE-2026-76642

Signed-off-by: Karel Zak <kzak@redhat.com>
(cherry picked from commit 1d14676ea70003e9f5b2a6a76af0cadb1190411a)
---
 libmount/src/context_mount.c | 23 ++++++++++++++++++++---
 libmount/src/hook_loopdev.c  | 13 +++++++++++--
 2 files changed, 31 insertions(+), 5 deletions(-)

diff --git a/libmount/src/context_mount.c b/libmount/src/context_mount.c
index 13b067895..ee84265f8 100644
--- a/libmount/src/context_mount.c
+++ b/libmount/src/context_mount.c
@@ -596,6 +596,22 @@ static int is_success_status(struct libmnt_context *cxt)
 	return 0;
 }
 
+/* Check if the mount stage explicitly failed (helper or syscall returned
+ * an error). Unlike is_success_status(), this treats "nothing happened"
+ * as not-failed -- the MOUNT stage may be a no-op for operations like
+ * bind/move with the new mount API where open_tree() runs in PREP and
+ * move_mount() is deferred to MOUNT_POST. */
+static int is_mount_stage_failed(struct libmnt_context *cxt)
+{
+	if (mnt_context_helper_executed(cxt))
+		return mnt_context_get_helper_status(cxt) != 0;
+
+	if (mnt_context_syscall_called(cxt))
+		return mnt_context_get_status(cxt) != 1;
+
+	return 0;
+}
+
 /* try mount(2) for all items in comma separated list of the filesystem @types */
 static int do_mount_by_types(struct libmnt_context *cxt, const char *types)
 {
@@ -935,8 +951,9 @@ int mnt_context_do_mount(struct libmnt_context *cxt)
 	} else
 		res = do_mount_by_pattern(cxt, cxt->fstype_pattern);
 
-	/* after mount stage */
-	if (res == 0) {
+	/* after mount stage -- the post-mount hooks are commit-path only,
+	 * skip them if the mount helper or syscall has failed */
+	if (res == 0 && !is_mount_stage_failed(cxt)) {
 		rc = mnt_context_call_hooks(cxt, MNT_STAGE_MOUNT_POST);
 		if (rc)
 			return rc;
@@ -1119,7 +1136,7 @@ again:
 		}
 	}
 
-	if (rc == 0)
+	if (rc == 0 && !is_mount_stage_failed(cxt))
 		rc = mnt_context_call_hooks(cxt, MNT_STAGE_POST);
 
 	mnt_context_deinit_hooksets(cxt);
diff --git a/libmount/src/hook_loopdev.c b/libmount/src/hook_loopdev.c
index 597b9339a..747d7b186 100644
--- a/libmount/src/hook_loopdev.c
+++ b/libmount/src/hook_loopdev.c
@@ -23,6 +23,8 @@ struct hook_data {
 	int loopdev_fd;
 };
 
+static int delete_loopdev(struct libmnt_context *cxt, struct hook_data *hd);
+
 /* de-initiallize this module */
 static int hookset_deinit(struct libmnt_context *cxt, const struct libmnt_hookset *hs)
 {
@@ -30,9 +32,16 @@ static int hookset_deinit(struct libmnt_context *cxt, const struct libmnt_hookse
 
 	DBG(HOOK, ul_debugobj(hs, "deinit '%s'", hs->name));
 
-	/* remove all our hooks */
+	/* remove all our hooks and free hook data */
 	while (mnt_context_remove_hook(cxt, hs, 0, &data) == 0) {
-		free(data);
+		if (data) {
+			struct hook_data *hd = (struct hook_data *) data;
+
+			/* cleanup after skipped MOUNT_POST hook */
+			if (hd->loopdev_fd > -1)
+				delete_loopdev(cxt, hd);
+			free(hd);
+		}
 		data = NULL;
 	}
 
-- 
2.55.0

