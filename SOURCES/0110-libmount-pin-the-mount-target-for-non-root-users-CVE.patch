diff --git a/libmount/src/context.c b/libmount/src/context.c
index 8e00b75a9..3d0717e72 100644
--- a/libmount/src/context.c
+++ b/libmount/src/context.c
@@ -60,6 +60,8 @@ struct libmnt_context *mnt_new_context(void)
 
 	cxt->loopdev_fd = -1;
 
+	cxt->fd_target = -1;
+
 	/* if we're really root and aren't running setuid */
 	cxt->restricted = (uid_t) 0 == ruid && ruid == euid ? 0 : 1;
 
@@ -157,6 +159,7 @@ int mnt_reset_context(struct libmnt_context *cxt)
 	}
 
 	mnt_context_reset_status(cxt);
+	mnt_context_close_target_fd(cxt);
 
 	if (cxt->table_fltrcb)
 		mnt_context_set_tabfilter(cxt, NULL, NULL);
@@ -286,6 +289,40 @@ int mnt_context_is_restricted(struct libmnt_context *cxt)
 	return cxt->restricted;
 }
 
+int mnt_context_target_fd_required(struct libmnt_context *cxt)
+{
+	return mnt_context_is_restricted(cxt);
+}
+
+int mnt_context_get_target_fd(struct libmnt_context *cxt)
+{
+	assert(cxt);
+
+	if (cxt->fd_target < 0) {
+		const char *target = mnt_fs_get_target(cxt->fs);
+
+		if (!target) {
+			/* keep errno usable for callers which use -errno */
+			errno = EINVAL;
+			return -EINVAL;
+		}
+		cxt->fd_target = ul_open_no_symlinks(target,
+					O_PATH | O_CLOEXEC, 0);
+		DBG(CXT, ul_debugobj(cxt,"open target fd=%d [%s]",
+					cxt->fd_target, target));
+	}
+	return cxt->fd_target;
+}
+
+void mnt_context_close_target_fd(struct libmnt_context *cxt)
+{
+	assert(cxt);
+
+	if (cxt->fd_target >= 0)
+		close(cxt->fd_target);
+	cxt->fd_target = -1;
+}
+
 /**
  * mnt_context_set_optsmode
  * @cxt: mount context
@@ -1633,6 +1670,48 @@ static int mkdir_target(const char *tgt, struct libmnt_fs *fs)
 	return rc;
 }
 
+/*
+ * Pin the target for non-root users.
+ *
+ * The target comes from fstab, but any component of the path may be a symlink
+ * controlled by the user. mnt_resolve_path() would follow it with root
+ * privileges and the mount would end up somewhere else. Open the path as it is
+ * with RESOLVE_NO_SYMLINKS instead, and then use the name the kernel gives to
+ * the pinned directory as the canonical target.
+ *
+ * The name is symlink free and normalized, and it's the same name the kernel
+ * later reports in mountinfo -- utab and non-root umount rely on that.
+ */
+static int pin_target(struct libmnt_context *cxt)
+{
+	const char *tgt;
+	char *path;
+	int fd, rc = 0;
+
+	fd = mnt_context_get_target_fd(cxt);
+	if (fd < 0) {
+		/* note that the kernel refuses a symlink in the path with
+		 * ELOOP, mount(8) reports it as "mount failed: Too many
+		 * levels of symbolic links" */
+		rc = -errno;
+		DBG(CXT, ul_debugobj(cxt, "failed to pin target [rc=%d]", rc));
+		return rc;
+	}
+
+	path = ul_fd_get_path(fd);
+	if (!path) {
+		DBG(CXT, ul_debugobj(cxt, "failed to read pinned target path"));
+		return -errno;
+	}
+
+	tgt = mnt_fs_get_target(cxt->fs);
+	if (!tgt || strcmp(path, tgt) != 0)
+		rc = mnt_fs_set_target(cxt->fs, path);
+
+	free(path);
+	return rc;
+}
+
 int mnt_context_prepare_target(struct libmnt_context *cxt)
 {
 	const char *tgt;
@@ -1660,20 +1739,27 @@ int mnt_context_prepare_target(struct libmnt_context *cxt)
 			return rc;	/* mkdir or parse error */
 	}
 
-	/* canonicalize the path */
-	cache = mnt_context_get_cache(cxt);
-	if (cache) {
-		char *path = mnt_resolve_path(tgt, cache);
-		if (path && strcmp(path, tgt) != 0)
-			rc = mnt_fs_set_target(cxt->fs, path);
+	/* canonicalize the path; for non-root users this is done from the
+	 * pinned target FD, see pin_target() */
+	if (!mnt_context_target_fd_required(cxt)) {
+		cache = mnt_context_get_cache(cxt);
+		if (cache) {
+			char *path = mnt_resolve_path(tgt, cache);
+			if (path && strcmp(path, tgt) != 0)
+				rc = mnt_fs_set_target(cxt->fs, path);
+		}
 	}
 
+	if (rc == 0 && mnt_context_target_fd_required(cxt))
+		rc = pin_target(cxt);
+
 	if (rc)
-		DBG(CXT, ul_debugobj(cxt, "failed to prepare target '%s'", tgt));
+		DBG(CXT, ul_debugobj(cxt, "failed to prepare target '%s' [rc=%d]",
+					tgt, rc));
 	else
 		DBG(CXT, ul_debugobj(cxt, "final target '%s'",
 					mnt_fs_get_target(cxt->fs)));
-	return 0;
+	return rc;
 }
 
 /* Guess type, but not set to cxt->fs, always use free() for the result. It's
diff --git a/libmount/src/context_mount.c b/libmount/src/context_mount.c
index a8e84127c..8199887e7 100644
--- a/libmount/src/context_mount.c
+++ b/libmount/src/context_mount.c
@@ -22,6 +22,7 @@
 #include "linux_version.h"
 #include "mountP.h"
 #include "strutils.h"
+#include "fileutils.h"
 
 /*
  * Kernel supports only one MS_PROPAGATION flag change by one mount(2) syscall,
@@ -261,7 +262,15 @@ static int fix_optstr(struct libmnt_context *cxt)
 		free(fs->user_optstr);
 		fs->user_optstr = NULL;
 	}
+
+	/* A multi-step mount(2) sequence is not atomic: between the calls the
+	 * filesystem is already attached, but without the security flags
+	 * (nosuid, noexec, ...), and the additional calls address the target
+	 * by pathname again.  Refuse it for non-root users.
+	 */
 	if (cxt->mountflags & MS_PROPAGATION) {
+		if (mnt_context_is_restricted(cxt))
+			goto eperm;
 		rc = init_propagation(cxt);
 		if (rc)
 			return rc;
@@ -269,6 +278,8 @@ static int fix_optstr(struct libmnt_context *cxt)
 	if ((cxt->mountflags & MS_BIND)
 	    && (cxt->mountflags & MNT_BIND_SETTABLE)
 	    && !(cxt->mountflags & MS_REMOUNT)) {
+		if (mnt_context_is_restricted(cxt))
+			goto eperm;
 		rc = init_bind_remount(cxt);
 		if (rc)
 			return rc;
@@ -359,6 +370,9 @@ done:
 	if (rc)
 		rc = -MNT_ERR_MOUNTOPT;
 	return rc;
+eperm:
+	DBG(CXT, ul_debugobj(cxt, "multi-step mount(2) refused for non-root user"));
+	return -EPERM;
 }
 
 /*
@@ -724,8 +738,9 @@ static int do_mount_additional(struct libmnt_context *cxt,
  */
 static int do_mount(struct libmnt_context *cxt, const char *try_type)
 {
-	int rc = 0;
-	const char *src, *target, *type;
+	int rc = 0, fd_src = -1;
+	const char *src, *target, *mnt_target, *type;
+	char tgtfdpath[UL_FDPATH_BUFSIZ], srcfdpath[UL_FDPATH_BUFSIZ];
 	unsigned long flags;
 
 	assert(cxt);
@@ -769,11 +784,69 @@ static int do_mount(struct libmnt_context *cxt, const char *try_type)
 	if (try_type)
 		flags |= MS_SILENT;
 
+	/* For non-root users mount(2) the already pinned target FD rather
+	 * than the path. mount(2) resolves the path for the second time and
+	 * the result does not have to be the directory we have verified in
+	 * mnt_context_prepare_target(). The kernel follows the /proc/ link
+	 * directly to the pinned directory, and mountinfo still reports the
+	 * real mountpoint path.
+	 *
+	 * Fallback to the path if /proc is not available; mount(2) is racy by
+	 * design, let's harden it where we can.
+	 */
+	mnt_target = target;
+
+	if (mnt_context_target_fd_required(cxt)) {
+		int fd = mnt_context_get_target_fd(cxt);
+		struct stat st;
+
+		if (fd < 0)
+			return -errno;
+		if (!ul_fd_mkpath(tgtfdpath, sizeof(tgtfdpath), fd))
+			return -errno;
+
+		if (stat(tgtfdpath, &st) == 0)
+			mnt_target = tgtfdpath;
+		else
+			DBG(CXT, ul_debugobj(cxt, "%s not accessible, "
+					"using target path", tgtfdpath));
+	}
+
+	/* The source of a bind or move operation is a pathname resolved by
+	 * mount(2) too, so for non-root users pin it in the same way as the
+	 * target. Otherwise a symlink in the source path is followed and the
+	 * kernel attaches something else than the directory from fstab.
+	 *
+	 * Note that mnt_context_prepare_srcpath() has already canonicalized
+	 * the path with root privileges; the pin closes the window between
+	 * that and the path resolution done by mount(2).
+	 */
+	if (mnt_context_target_fd_required(cxt)
+	    && (flags & (MS_BIND | MS_MOVE))
+	    && !(flags & MS_REMOUNT)
+	    && mnt_fs_get_srcpath(cxt->fs)) {
+		struct stat st;
+
+		fd_src = ul_open_no_symlinks(src, O_PATH | O_CLOEXEC, 0);
+		if (fd_src < 0)
+			return -errno;
+		if (!ul_fd_mkpath(srcfdpath, sizeof(srcfdpath), fd_src)) {
+			rc = -errno;
+			goto done;
+		}
+
+		if (stat(srcfdpath, &st) == 0)
+			src = srcfdpath;
+		else
+			DBG(CXT, ul_debugobj(cxt, "%s not accessible, "
+					"using source path", srcfdpath));
+	}
+
 	DBG(CXT, ul_debugobj(cxt, "%smount(2) "
 			"[source=%s, target=%s, type=%s, "
 			" mountflags=0x%08lx, mountdata=%s]",
 			mnt_context_is_fake(cxt) ? "(FAKE) " : "",
-			src, target, type,
+			src, mnt_target, type,
 			flags, cxt->mountdata ? "yes" : "<none>"));
 
 	if (mnt_context_is_fake(cxt)) {
@@ -786,17 +859,20 @@ static int do_mount(struct libmnt_context *cxt, const char *try_type)
 		/*
 		 * propagation flags *only*
 		 */
-		if (do_mount_additional(cxt, target, flags, &cxt->syscall_status))
-			return -MNT_ERR_APPLYFLAGS;
+		if (do_mount_additional(cxt, target, flags, &cxt->syscall_status)) {
+			rc = -MNT_ERR_APPLYFLAGS;
+			goto done;
+		}
 	} else {
 		/*
 		 * regular mount
 		 */
-		if (mount(src, target, type, flags, cxt->mountdata)) {
+		if (mount(src, mnt_target, type, flags, cxt->mountdata)) {
 			cxt->syscall_status = -errno;
 			DBG(CXT, ul_debugobj(cxt, "mount(2) failed [errno=%d %m]",
 							-cxt->syscall_status));
-			return -cxt->syscall_status;
+			rc = -cxt->syscall_status;
+			goto done;
 		}
 		DBG(CXT, ul_debugobj(cxt, "  success"));
 		cxt->syscall_status = 0;
@@ -808,7 +884,8 @@ static int do_mount(struct libmnt_context *cxt, const char *try_type)
 		    && do_mount_additional(cxt, target, flags, NULL)) {
 
 			/* TODO: call umount? */
-			return -MNT_ERR_APPLYFLAGS;
+			rc = -MNT_ERR_APPLYFLAGS;
+			goto done;
 		}
 	}
 
@@ -818,6 +895,9 @@ static int do_mount(struct libmnt_context *cxt, const char *try_type)
 			rc = mnt_fs_set_fstype(fs, try_type);
 	}
 
+done:
+	if (fd_src >= 0)
+		close(fd_src);
 	return rc;
 }
 
